-- conferir antes de atualizar
select * from clientes;
select * from produtos;

-- ========== UPDATE (exemplos da aula) ==========

-- 1) atualizar uma coluna
update clientes
set nome = 'ana silva siqueira'
where id = 1;

select * from clientes;

-- 2) atualizar duas colunas de uma vez
update clientes
set nome = 'ana silva siqueira', cidade = 'campo mourão'
where id = 1;

select * from clientes;

-- ========== UPDATE (prática com produtos) ==========

-- novo preço do teclado
update produtos
set preco = 175.00
where id = 1;

-- repor estoque do monitor
update produtos
set estoque = 20
where id = 3;

-- mudar nome e categoria da webcam
update produtos
set nome = 'webcam full hd', categoria = 'câmeras'
where id = 5;

select * from produtos;
